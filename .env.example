# KhetVaani Environment Configuration Template
# Copy this file to .env and fill in your values

# Google Gemini AI API Key (for Voice AI Engine & Multi-Lingual Assistant)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port
PORT=3000

# Node Environment
NODE_ENV=development

# AWS Configuration (optional for local dev / cloud integrations)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-s3-audio-bucket-name

# Database Configuration (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=khetvaani
DB_USER=postgres
DB_PASSWORD=your_password_here
